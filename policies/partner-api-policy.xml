<!-- 
  PARTNER API POLICY — Quick onboarding for new partner integration
  TODO: Security review needed before going to production
-->
<policies>
    <inbound>
        <base />
        
        <!-- Wide-open CORS for partner testing -->
        <cors allow-credentials="true">
            <allowed-origins>
                <origin>*</origin>
            </allowed-origins>
            <allowed-methods preflight-result-max-age="300">
                <method>*</method>
            </allowed-methods>
            <allowed-headers>
                <header>*</header>
            </allowed-headers>
        </cors>

        <!-- No auth for now — will add JWT later -->
        <!-- <validate-jwt ... /> -->

        <!-- No rate limiting yet — partners need unlimited access for testing -->
    </inbound>

    <backend>
        <!-- Using HTTP for internal backend (faster, no cert overhead) -->
        <set-backend-service base-url="http://10.0.1.45:3000/api" />
    </backend>

    <outbound>
        <base />
    </outbound>

    <!-- No error handling yet -->
</policies>
