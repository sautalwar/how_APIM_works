<!--
  POLICY FRAGMENT: IP Filtering
  Allow only known IP ranges and block everything else.
  Usage: <include-fragment fragment-id="ip-filtering" />
-->
<fragment>
    <ip-filter action="allow">
        <!-- VPN exit points (use your actual public IPs) -->
        <address>203.0.113.50</address>
        <address>203.0.113.51</address>
        <!-- Azure DevOps / GitHub Actions runners (if needed) -->
        <address-range from="20.37.194.0" to="20.37.194.255" />
        <!-- Note: Internal IP ranges (10.x.x.x, 192.168.x.x, 172.16-31.x.x) removed to prevent SSRF (OWASP API7) -->
        <!-- If you need to allow internal IPs, use Azure Private Link or VNet integration instead -->
    </ip-filter>
    
    <!-- Security headers (OWASP API8) -->
    <set-header name="Server" exists-action="delete" />
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="X-Content-Type-Options" exists-action="override">
        <value>nosniff</value>
    </set-header>
    <set-header name="Strict-Transport-Security" exists-action="override">
        <value>max-age=31536000; includeSubDomains</value>
    </set-header>
</fragment>
