<!--
  POLICY FRAGMENT: Rate Limiting
  Reusable rate limiting with both per-key throttling and daily quotas.
  Usage: <include-fragment fragment-id="rate-limiting" />
-->
<fragment>
    <!-- Per-subscription rate limit: 100 calls/minute -->
    <rate-limit-by-key calls="100"
                       renewal-period="60"
                       counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)"
                       remaining-calls-header-name="X-RateLimit-Remaining"
                       total-calls-header-name="X-RateLimit-Limit"
                       retry-after-header-name="Retry-After" />

    <!-- Daily quota: 10,000 calls/day -->
    <quota-by-key calls="10000"
                  bandwidth="104857600"
                  renewal-period="86400"
                  counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)" />
</fragment>
