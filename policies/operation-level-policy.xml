<!--
  OPERATION-LEVEL POLICY — Applied to specific operations (e.g., DELETE /products/{id})
  Inherits API-level and global policies via <base />.
  Adds operation-specific authorization (admin-only for DELETE).
-->
<policies>
    <inbound>
        <base />

        <!-- Require Admin role for this operation -->
        <validate-jwt header-name="Authorization" 
                      require-signed-tokens="true"
                      require-expiration-time="true">
            <openid-config url="https://login.microsoftonline.com/{{tenant-id}}/v2.0/.well-known/openid-configuration" />
            <required-claims>
                <claim name="roles" match="any">
                    <value>Products.Admin</value>
                    <value>GlobalAdmin</value>
                </claim>
            </required-claims>
        </validate-jwt>

        <!-- Request body size validation (OWASP API4) -->
        <validate-content max-size="102400" size-exceeded-action="detect" />

        <!-- Validate the product ID parameter format (UUID) -->
        <choose>
            <when condition="@(!System.Text.RegularExpressions.Regex.IsMatch(
                context.Request.MatchedParameters.GetValueOrDefault(&quot;id&quot;, &quot;&quot;), 
                @&quot;^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$|^[0-9]+$&quot;))">
                <return-response>
                    <set-status code="400" reason="Bad Request" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"error": "Invalid product ID format"}</set-body>
                </return-response>
            </when>
        </choose>

        <!-- Extra rate limit for destructive operations -->
        <rate-limit-by-key calls="10"
                           renewal-period="60"
                           counter-key="@(context.Subscription.Id + &quot;-delete&quot;)" />
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <base />

        <!-- Log deletion for audit trail -->
        <trace source="AuditLog" severity="information">
            <message>@($"Product deleted: {context.Request.MatchedParameters.GetValueOrDefault("id", "unknown")} by {context.Request.Headers.GetValueOrDefault("Authorization", "unknown").Substring(0, 20)}...")</message>
        </trace>

        <!-- Remove server fingerprinting headers (OWASP API8) -->
        <set-header name="Server" exists-action="delete" />
        <set-header name="X-Powered-By" exists-action="delete" />
        <set-header name="X-AspNet-Version" exists-action="delete" />

        <!-- Security headers (OWASP API8) -->
        <set-header name="X-Content-Type-Options" exists-action="override">
            <value>nosniff</value>
        </set-header>
        <set-header name="Strict-Transport-Security" exists-action="override">
            <value>max-age=31536000; includeSubDomains</value>
        </set-header>
    </outbound>

    <on-error>
        <base />
        
        <!-- Safe error response - prevent stack trace leakage (OWASP API8) -->
        <return-response>
            <set-status code="500" reason="Internal Server Error" />
            <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
            </set-header>
            <set-body>{"error": "An error occurred while processing your request. Please contact support with correlation ID.", "correlationId": "@(context.RequestId)"}</set-body>
        </return-response>
    </on-error>
</policies>
